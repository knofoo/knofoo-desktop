{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "knofoo",
  "version": "0.1.0",
  "identifier": "com.knofoo.knofoo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' http://127.0.0.1:7421 ws://127.0.0.1:7421 http://127.0.0.1:7422 ws://127.0.0.1:7422; img-src 'self' data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "knofoo",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "decorations": false,
        "zoomHotkeysEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
